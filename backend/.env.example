# DATABASE_URL 和 REDIS_URL 由 Railway 画布关联后自动注入
# 本地开发：从 Railway 控制台 PostgreSQL / Redis Connect 面板复制
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST].railway.app:[PORT]/railway
REDIS_URL=redis://default:[PASSWORD]@[HOST].railway.app:[PORT]

APP_NAME=FareSniper Backend
API_PREFIX=/api
DEFAULT_USER_ID=demo-user
DEFAULT_ORIGIN=BJS
ENABLE_MOCK_FALLBACK=true
SESSION_TTL_MINUTES=30

# 逗号分隔或 JSON 数组，例如 https://app.example.com,https://staging.example.com
CORS_ORIGINS=

# ── LLM 配置（OpenAI Chat Completions 兼容接口：通义/DeepSeek/GLM 等）──
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=sk-your-api-key-here
MODEL_INTENT=qwen-plus            # IntentParser，追求低延迟
MODEL_JUDGE=deepseek-v3           # ValueJudge，追求质量
MODEL_AGENT=qwen-plus             # ReAct Agent 主推理模型

# ── 鉴权 ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# ── WebPush（VAPID）─────────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@faresniper.app

# ── 航班动态 API ────────────────────────────────────────────────────────────
FLIGHT_STATUS_API_URL=
FLIGHT_STATUS_API_KEY=

# ── CPS 联盟 ────────────────────────────────────────────────────────────────
CPS_ID_DEFAULT=

# ── Langfuse 提示词版本化 ───────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_OFFLINE=false

# ── LangSmith 观测（可选）───────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=faresniper-dev
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here
LANGCHAIN_PROJECT=faresniper
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
