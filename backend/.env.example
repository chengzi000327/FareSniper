# DATABASE_URL 和 REDIS_URL 由 Railway 画布关联后自动注入
# 本地开发：从 Railway 控制台 PostgreSQL / Redis Connect 面板复制
DATABASE_URL=
REDIS_URL=

# 独立的测试 PG（Railway 上单独建一个 PostgreSQL 服务），所有 pytest 测试连这条
# 千万不要把 prod DATABASE_URL 复制过来——会污染线上数据
TEST_DATABASE_URL=

APP_NAME=FareSniper Backend
API_PREFIX=/api
DEFAULT_USER_ID=demo-user
DEFAULT_ORIGIN=BJS
ENABLE_MOCK_FALLBACK=false
SESSION_TTL_MINUTES=30

# 逗号分隔或 JSON 数组，例如 https://app.example.com,https://staging.example.com
CORS_ORIGINS=["https://sweet-connection-production.up.railway.app"]

# ── LLM 配置（OpenAI Chat Completions 兼容接口：通义/DeepSeek/GLM 等）──
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_INTENT=qwen-plus            # IntentParser，追求低延迟
MODEL_JUDGE=deepseek-v3           # ValueJudge，追求质量
MODEL_AGENT=qwen-plus             # ReAct Agent 主推理模型
MODEL_THINKING=disabled           # deepseek-v4 等 thinking 模型显式关闭思考模式

# ── 鉴权 ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# ── WebPush（VAPID）─────────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@faresniper.app

# ── 航班动态 API ────────────────────────────────────────────────────────────
FLIGHT_STATUS_API_URL=
FLIGHT_STATUS_API_KEY=

# ── CPS 联盟 ────────────────────────────────────────────────────────────────
CPS_ID_DEFAULT=

# ── 真实机票来源 ───────────────────────────────────────────────────────────
FLYAI_API_KEY=
FLYAI_CLI_PATH=flyai
SERPAPI_API_KEY=
VARIFLIGHT_API_KEY=
FLIGHT_PROVIDER_TIMEOUT_SECONDS=10
CTRIP_SNAPSHOT_TTL_MINUTES=75
CTRIP_REFRESH_BATCH_SIZE=20
CTRIP_REQUEST_DELAY_MIN_SECONDS=2
CTRIP_REQUEST_DELAY_MAX_SECONDS=5
RUN_SCHEDULER_IN_API=false

# ── LangSmith 观测（可选）───────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=faresniper
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=false
