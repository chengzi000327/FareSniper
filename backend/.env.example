# DATABASE_URL 和 REDIS_URL 由 Railway 画布关联后自动注入
# 本地开发：从 Railway 控制台 PostgreSQL / Redis Connect 面板复制
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST].railway.app:[PORT]/railway
REDIS_URL=redis://default:[PASSWORD]@[HOST].railway.app:[PORT]

APP_NAME=FareSniper Backend
API_PREFIX=/api
DEFAULT_USER_ID=demo-user
DEFAULT_ORIGIN=BJS
ENABLE_MOCK_FALLBACK=true
SESSION_TTL_MINUTES=30

# ── LLM 配置（支持 OpenAI Chat Completions 兼容接口：通义/DeepSeek/GLM 等）──
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=sk-your-api-key-here
MODEL_INTENT=qwen-plus            # IntentParser，追求低延迟
MODEL_JUDGE=deepseek-v3           # ValueJudge，追求质量

# ── LangSmith 观测（可选）────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here
LANGCHAIN_PROJECT=faressniper
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
